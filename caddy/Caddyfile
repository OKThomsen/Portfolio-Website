# One block per site. Caddy gets and renews each HTTPS certificate by itself (Let's Encrypt),
# redirects http to https, and passes requests to the app by its name on the `web` network.
# After editing: `docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile`.

# The pool tournament platform (~/Projects/pool-tournament-app). Its live updates
# (Server-Sent Events) are streamed through without buffering.
turneringsportal.kjaer-thomsen.dk {
	reverse_proxy pool-app:3000
}

# This portfolio website.
oskar.kjaer-thomsen.dk {
	reverse_proxy portfolio-app:8080
}
