@page
@model IndexModel
@{
    ViewData["Title"] = "Software Engineer";
}

<section class="hero">
    <div class="section-inner">
        <p class="eyebrow">Software Engineer · M.Sc. Software Engineering, SDU</p>
        <h1>Oskar Kjær Thomsen</h1>
        <p class="lede">
            I build backend systems and data pipelines, and I'm now focused on the
            Microsoft development stack &mdash; this site itself is built with
            ASP.NET Core, EF Core, and SQL Server.
        </p>
        <div class="hero-links">
            <a class="btn primary" href="#projects">View Projects</a>
            <a class="btn" href="https://github.com/okthomsen" target="_blank" rel="noopener">GitHub</a>
            <a class="btn" href="https://www.linkedin.com/in/oskar-kj%C3%A6r-thomsen-4880b7244/" target="_blank" rel="noopener">LinkedIn</a>
            <a class="btn" href="~/files/CV.pdf" target="_blank" rel="noopener">CV</a>
        </div>
    </div>
</section>

<section id="about">
    <div class="section-inner">
        <p class="eyebrow">About</p>
        <h2>Background</h2>
        <!-- DRAFT copy for Oskar to review/edit before publishing -->
        <p>
            I finished a Master's in Software Engineering at the University of
            Southern Denmark in 2025, after a Bachelor's in the same program. My
            project work spans backend and data-processing systems &mdash; from a
            satellite-imagery pipeline built for the Danish Environmental Protection
            Agency to a microservice-based streaming platform mockup and an embedded
            wildlife-monitoring system that uses a local LLM for image annotation.
        </p>
        <p>
            I'm currently focused on moving into the Microsoft ecosystem &mdash;
            ASP.NET Core, Entity Framework Core, SQL Server, and Azure &mdash; and
            this site is built on that stack as a working example of it, not just a
            claim on a resume.
        </p>
    </div>
</section>

<section id="skills">
    <div class="section-inner wide">
        <p class="eyebrow">Skills</p>
        <h2>Technical Skills</h2>
        <div class="skill-groups">
            @foreach (var category in Model.SkillCategories)
            {
                <div class="skill-group">
                    <h3>@category.Name</h3>
                    <ul class="skill-list">
                        @foreach (var skill in category.Skills)
                        {
                            <li>@skill.Name</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

<section id="projects">
    <div class="section-inner wide">
        <p class="eyebrow">Projects</p>
        <h2>Featured Projects</h2>
        <div class="project-list">
            @foreach (var project in Model.FeaturedProjects)
            {
                <article class="project-card">
                    <h3>@project.Title</h3>
                    <p class="summary">@project.Summary</p>
                    <ul class="tech-list">
                        @foreach (var tech in project.Technologies)
                        {
                            <li>@tech.Name</li>
                        }
                    </ul>
                    <div class="project-links">
                        @if (!string.IsNullOrEmpty(project.RepositoryUrl))
                        {
                            <a href="@project.RepositoryUrl" target="_blank" rel="noopener">Source code</a>
                        }
                        @if (!string.IsNullOrEmpty(project.DemoUrl))
                        {
                            <a href="@project.DemoUrl" target="_blank" rel="noopener">Live demo</a>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section id="education">
    <div class="section-inner">
        <p class="eyebrow">Education</p>
        <h2>Education</h2>
        <div class="education-entry">
            <h3>M.Sc. Software Engineering</h3>
            <p class="meta">University of Southern Denmark, Odense &middot; Sep 2023 &ndash; Jun 2025</p>
        </div>
        <div class="education-entry">
            <h3>B.Sc. Software Engineering</h3>
            <p class="meta">University of Southern Denmark, Odense &middot; Sep 2020 &ndash; Jun 2023</p>
        </div>
    </div>
</section>

<section id="contact">
    <div class="section-inner">
        <p class="eyebrow">Contact</p>
        <h2>Get in Touch</h2>
        <p>Best reached by email or LinkedIn.</p>
        <ul class="contact-links">
            <li><a href="mailto:oskar@kjaer-thomsen.dk">oskar@kjaer-thomsen.dk</a></li>
            <li><a href="https://www.linkedin.com/in/oskar-kj%C3%A6r-thomsen-4880b7244/" target="_blank" rel="noopener">LinkedIn</a></li>
            <li><a href="https://github.com/okthomsen" target="_blank" rel="noopener">GitHub</a></li>
        </ul>
    </div>
</section>
