@page
@model IndexModel
@{
    ViewData["Title"] = "Software Engineer";
}

<section class="hero">
    <div class="section-inner">
        <p class="eyebrow">Software Engineer · M.Sc. Software Engineering, SDU</p>
        <h1>Oskar Kjær Thomsen</h1>
        <p class="lede">
            I build backend systems and data pipelines, and I'm now focused on the
            Microsoft development stack &mdash; this site itself is built with
            ASP.NET Core, EF Core, and SQL Server.
        </p>
        <div class="hero-links">
            <a class="btn primary" href="#projects">View Projects</a>
            <a class="btn" href="https://github.com/okthomsen" target="_blank" rel="noopener">GitHub</a>
            <a class="btn" href="https://www.linkedin.com/in/oskar-kj%C3%A6r-thomsen-4880b7244/" target="_blank" rel="noopener">LinkedIn</a>
        </div>
    </div>
</section>

<section id="skills">
    <div class="section-inner wide">
        <p class="eyebrow">Skills</p>
        <h2>Technical Skills</h2>
        <div class="skill-groups">
            @foreach (var category in Model.SkillCategories)
            {
                <div class="skill-group">
                    <h3>@category.Name</h3>
                    <ul class="skill-list">
                        @foreach (var skill in category.Skills)
                        {
                            <li>@skill.Name</li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

<section id="projects">
    <div class="section-inner wide">
        <p class="eyebrow">Projects</p>
        <h2>Featured Projects</h2>
        <div class="project-list">
            @foreach (var project in Model.FeaturedProjects)
            {
                <article class="project-card">
                    <h3>@project.Title</h3>
                    <p class="summary">@project.Summary</p>
                    <ul class="tech-list">
                        @foreach (var tech in project.Technologies)
                        {
                            <li>@tech.Name</li>
                        }
                    </ul>
                    <div class="project-links">
                        @if (!string.IsNullOrEmpty(project.RepositoryUrl))
                        {
                            <a href="@project.RepositoryUrl" target="_blank" rel="noopener">Source code</a>
                        }
                        @if (!string.IsNullOrEmpty(project.DemoUrl))
                        {
                            <a href="@project.DemoUrl" target="_blank" rel="noopener">Live demo</a>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
