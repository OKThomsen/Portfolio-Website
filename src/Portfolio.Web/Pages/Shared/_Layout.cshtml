<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Oskar Kjær Thomsen" : "Oskar Kjær Thomsen — Software Engineer")</title>
    <meta name="description" content="Oskar Kjær Thomsen — Software Engineer, M.Sc. Software Engineering (SDU)." />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <nav class="site-nav" aria-label="Primary">
            <a class="brand" asp-page="/Index">Oskar Kjær Thomsen</a>
            <ul class="nav-links">
                <li><a href="/#about">About</a></li>
                <li><a href="/#skills">Skills</a></li>
                <li><a href="/#projects">Projects</a></li>
                <li><a href="/#education">Education</a></li>
                <li><a href="/#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>&copy; @DateTime.UtcNow.Year Oskar Kjær Thomsen</p>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
