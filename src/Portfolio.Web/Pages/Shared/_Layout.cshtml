<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? $"{t} · Oskar Kjær Thomsen" : "Oskar Kjær Thomsen — Software Engineer")</title>
    <meta name="description" content="Oskar Kjær Thomsen — Software Engineer, M.Sc. Software Engineering (SDU)." />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"])">
    <div class="site-bg" aria-hidden="true">
        <svg class="site-bg__wave" viewBox="0 0 1440 600" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <path id="wave-a" fill="none" stroke="currentColor" stroke-width="1.3" vector-effect="non-scaling-stroke"
                      d="M -120 180 C 220 40 380 300 640 220 C 900 140 1060 420 1560 300" />
                <path id="wave-b" fill="none" stroke="currentColor" stroke-width="1.3" vector-effect="non-scaling-stroke"
                      d="M -120 380 C 260 260 460 520 720 400 C 980 280 1180 520 1560 460" />
            </defs>
            <g>
                <use href="#wave-a" y="-56" opacity="0.12" />
                <use href="#wave-a" y="-48" opacity="0.18" />
                <use href="#wave-a" y="-40" opacity="0.26" />
                <use href="#wave-a" y="-32" opacity="0.34" />
                <use href="#wave-a" y="-24" opacity="0.42" />
                <use href="#wave-a" y="-16" opacity="0.50" />
                <use href="#wave-a" y="-8" opacity="0.56" />
                <use href="#wave-a" y="0" opacity="0.60" />
                <use href="#wave-a" y="8" opacity="0.56" />
                <use href="#wave-a" y="16" opacity="0.50" />
                <use href="#wave-a" y="24" opacity="0.42" />
                <use href="#wave-a" y="32" opacity="0.34" />
                <use href="#wave-a" y="40" opacity="0.26" />
                <use href="#wave-a" y="48" opacity="0.18" />
                <use href="#wave-a" y="56" opacity="0.12" />
            </g>
            <g>
                <use href="#wave-b" y="-40" opacity="0.08" />
                <use href="#wave-b" y="-32" opacity="0.14" />
                <use href="#wave-b" y="-24" opacity="0.22" />
                <use href="#wave-b" y="-16" opacity="0.30" />
                <use href="#wave-b" y="-8" opacity="0.36" />
                <use href="#wave-b" y="0" opacity="0.40" />
                <use href="#wave-b" y="8" opacity="0.36" />
                <use href="#wave-b" y="16" opacity="0.30" />
                <use href="#wave-b" y="24" opacity="0.22" />
                <use href="#wave-b" y="32" opacity="0.14" />
                <use href="#wave-b" y="40" opacity="0.08" />
            </g>
        </svg>
    </div>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
        <nav class="site-nav" aria-label="Primary">
            <a class="brand" asp-page="/Index">Oskar Kjær Thomsen</a>
            <ul class="nav-links">
                <li><a asp-page="/About">About</a></li>
                <li><a asp-page="/Contact">Contact</a></li>
            </ul>
            <ul class="nav-social" aria-label="Social">
                <li>
                    <a href="https://github.com/okthomsen" target="_blank" rel="noopener" aria-label="GitHub profile">
                        <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
                        </svg>
                    </a>
                </li>
                <li>
                    <a href="https://www.linkedin.com/in/oskar-kj%C3%A6r-thomsen-4880b7244/" target="_blank" rel="noopener" aria-label="LinkedIn profile">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
                            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z" />
                        </svg>
                    </a>
                </li>
            </ul>
        </nav>
    </header>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>&copy; @DateTime.UtcNow.Year Oskar Kjær Thomsen</p>
    </footer>

    <script src="~/js/site.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
