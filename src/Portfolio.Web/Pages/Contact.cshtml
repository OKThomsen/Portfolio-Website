@page
@model ContactModel
@{
    ViewData["Title"] = "Contact";
    ViewData["BodyClass"] = "fill-viewport";
}

<section id="contact">
    <div class="section-inner">
        <header class="section-header">
            <h1>Get in Touch</h1>
            <p class="lede">I'm open to software engineering roles &mdash; backend and cloud work with C#/.NET, SQL, Azure and more.</p>
        </header>
        <ul class="contact-methods">
            <li>
                <a class="contact-card" href="mailto:oskar@kjaer-thomsen.dk">
                    <span class="eyebrow">E-mail</span>
                    <span class="contact-card__value">oskar@kjaer-thomsen.dk</span>
                </a>
            </li>
            <li>
                <a class="contact-card" href="tel:+4528605415">
                    <span class="eyebrow">Phone</span>
                    <span class="contact-card__value">+45 28 60 54 15</span>
                </a>
            </li>
            <li>
                <a class="contact-card" href="https://www.linkedin.com/in/oskar-kj%C3%A6r-thomsen-4880b7244/" target="_blank" rel="noopener">
                    <span class="eyebrow">LinkedIn</span>
                    <span class="contact-card__value">Oskar Kjær Thomsen</span>
                </a>
            </li>
            <li>
                <a class="contact-card" href="https://github.com/okthomsen" target="_blank" rel="noopener">
                    <span class="eyebrow">GitHub</span>
                    <span class="contact-card__value">okthomsen</span>
                </a>
            </li>
        </ul>
    </div>
</section>
