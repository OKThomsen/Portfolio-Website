@page
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["BodyClass"] = "full-sections";
}

<section id="about">
    <div class="section-inner">
        <header class="section-header">
            <h1>Background</h1>
        </header>
        <div class="about-layout">
            <div class="about-prose">
                <p>
                    I finished a Master's in Software Engineering at the University of
                    Southern Denmark in 2025, after a Bachelor's in the same program. My
                    latest project runs the weekly tournaments at a local pool club, in
                    production, from the players' phones to the TV in the club. Before that,
                    my master's thesis was a satellite data pipeline for a case from the
                    Danish Environmental Protection Agency, and I built an embedded wildlife
                    camera that annotates its images with a local LLM.
                </p>
                <p>
                    I'm moving into the Microsoft ecosystem, and this site is my first
                    project in it: ASP.NET Core, Entity Framework Core and SQL Server,
                    running in Docker on a server I host myself. It's a working example of
                    the stack, not just a claim on a resume.
                </p>
            </div>
            <aside class="about-aside">
                <div class="about-card">
                    <p class="eyebrow">How this site is built</p>
                    <h3>This portfolio site</h3>
                    <p>
                        Built with ASP.NET Core Razor Pages, Entity Framework Core and SQL
                        Server, and self-hosted with Docker. The projects, skills and blog
                        posts are served from the database rather than hard-coded into the
                        markup.
                    </p>
                    <div class="about-card__links">
                        <a href="https://github.com/OKThomsen/Portfolio-Website" target="_blank" rel="noopener">Source code</a>
                        <a asp-page="/Blog/Post" asp-route-slug="building-this-portfolio-website">Blog post</a>
                    </div>
                </div>
                <div class="about-card about-card--cta">
                    <p class="eyebrow">Want to work together?</p>
                    <h3>Open to software engineering roles</h3>
                    <p>
                        I'm looking for my first full-time role as a software engineer. If
                        you're hiring, I'd like to hear from you.
                    </p>
                    <a class="btn primary" asp-page="/Contact">Go to contact</a>
                </div>
            </aside>
        </div>
    </div>
    <div class="scroll-cue">
        <a href="#education" aria-label="Scroll to Education">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M6 9l6 6 6-6" />
            </svg>
        </a>
    </div>
</section>

<section id="education">
    <div class="section-inner">
        <header class="section-header">
            <h2>Education</h2>
        </header>
        <div class="education-list">
            <div class="education-entry">
                <p class="eyebrow">Sep 2023 &ndash; Jun 2025</p>
                <h3>M.Sc. Software Engineering</h3>
                <p class="meta">University of Southern Denmark, Odense</p>
            </div>
            <div class="education-entry">
                <p class="eyebrow">Sep 2020 &ndash; Jun 2023</p>
                <h3>B.Sc. Software Engineering</h3>
                <p class="meta">University of Southern Denmark, Odense</p>
            </div>
        </div>
    </div>
</section>
