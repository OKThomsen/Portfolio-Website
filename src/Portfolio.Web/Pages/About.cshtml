@page
@model AboutModel
@{
    ViewData["Title"] = "About";
    ViewData["BodyClass"] = "full-sections";
}

<section id="about">
    <div class="section-inner">
        <h1>Background</h1>
        <!-- DRAFT copy for Oskar to review/edit before publishing -->
        <p>
            I finished a Master's in Software Engineering at the University of
            Southern Denmark in 2025, after a Bachelor's in the same program. My
            project work spans backend and data-processing systems &mdash; from a
            satellite-imagery pipeline built for the Danish Environmental Protection
            Agency to a microservice-based streaming platform mockup and an embedded
            wildlife-monitoring system that uses a local LLM for image annotation.
        </p>
        <p>
            I'm currently focused on moving into the Microsoft ecosystem &mdash;
            ASP.NET Core, Entity Framework Core, SQL Server, and Azure &mdash; and
            this site is built on that stack as a working example of it, not just a
            claim on a resume.
        </p>
    </div>
</section>

