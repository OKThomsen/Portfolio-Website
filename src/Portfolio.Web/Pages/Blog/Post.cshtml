@page "/blog/{slug}"
@model Portfolio.Web.Pages.Blog.PostModel
@{
    ViewData["Title"] = Model.Post.Title;
}

<section id="blog-post">
    <div class="section-inner">
        <a class="back-link" asp-page="/Blog/Index">&larr; Back to Blog</a>
        <h1>@Model.Post.Title</h1>
        <div class="blog-post__meta">
            <span>@Model.Post.PublishedOn.ToString("MMMM d, yyyy")</span>
            <ul class="tag-list">
                @foreach (var tag in Model.Post.Tags)
                {
                    <li>@tag.Name</li>
                }
            </ul>
        </div>
        <div class="blog-post__body">
            @Html.Raw(Model.Post.Body)
        </div>
        @if (Model.Post.RelatedProject is not null)
        {
            <div class="about-card">
                <p class="eyebrow">Related project</p>
                <h3>@Model.Post.RelatedProject.Title</h3>
                <p>@Model.Post.RelatedProject.Summary</p>
                @if (!string.IsNullOrEmpty(Model.Post.RelatedProject.RepositoryUrl))
                {
                    <div class="about-card__links">
                        <a href="@Model.Post.RelatedProject.RepositoryUrl" target="_blank" rel="noopener">Source code</a>
                    </div>
                }
            </div>
        }
    </div>
</section>
